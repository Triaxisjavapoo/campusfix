rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function user() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function participant(incidentId) {
      let incident = firestore.get(/databases/(default)/documents/incidents/$(incidentId)).data;
      return signedIn() && user().active == true &&
        (user().role == 'admin' || (user().role == 'reporter' && incident.reporterId == request.auth.uid) ||
         (user().role == 'technician' && incident.assignedTo == request.auth.uid));
    }
    match /incidents/{incidentId}/{uploaderId}/{evidenceId} {
      allow read: if participant(incidentId);
      allow create: if resource == null && participant(incidentId) && request.auth.uid == uploaderId &&
        evidenceId.size() <= 128 && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if signedIn() && request.auth.uid == uploaderId && user().active == true &&
        !firestore.exists(/databases/(default)/documents/incidents/$(incidentId)/evidence/$(evidenceId));
      allow update: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
